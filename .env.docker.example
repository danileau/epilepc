# Copy to .env.local OR pass through docker compose env_file for overrides.
# docker-compose.yml has sensible defaults for everything below.

# UID/GID match host so the bind-mount stays writable.
UID=1000
GID=1000

# Symfony.
APP_SECRET=dev-secret-not-for-prod-d1c50a

# Where ciphra is running (used both for CORS and for the migration link the
# epilepc profile page renders). Default = local Vite dev server.
CIPHRA_ORIGIN=http://localhost:5173

# Host:port that ciphra's /migrate page should fetch the bundle from.
# Must match what the user's BROWSER can reach — i.e. not the docker
# internal hostname. Default 8081 because ciphra's frontend container
# already binds host port 8080.
EPILEPC_ORIGIN=localhost:8081

# Goes into the bundle's `epilepc_decommission_at` field.
EPILEPC_DECOMMISSION_AT=2026-10-01T00:00:00Z

# Lifecycle phase. One of: normal | announce | warn | readonly | decommission
# Flip this and `docker compose up -d --force-recreate app` to walk through
# the deprecation states without code changes.
EPILEPC_LIFECYCLE_PHASE=normal

# Seed N demo users on the next `docker compose up`. After first boot you'll
# probably want to flip this back to 0 to avoid re-seed log spam.
SEED_ON_BOOT=1
SEED_USERS=2
